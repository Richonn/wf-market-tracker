      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "wfmt-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  i.name,\n  latest.sell_median,\n  latest.active_sell_orders,\n  latest.active_buy_orders,\n  ROUND(\n    (latest.sell_median - prev24h.sell_median)::numeric\n    / NULLIF(prev24h.sell_median, 0) * 100, 1\n  ) AS change_24h_pct,\n  ROUND(\n    (latest.sell_median - prev7d.sell_median)::numeric\n    / NULLIF(prev7d.sell_median, 0) * 100, 1\n  ) AS change_7d_pct\nFROM items i\nJOIN LATERAL (\n  SELECT sell_median, active_sell_orders, active_buy_orders\n  FROM price_snapshots\n  WHERE item_slug = i.slug\n  ORDER BY collected_at DESC\n  LIMIT 1\n) latest ON true\nLEFT JOIN LATERAL (\n  SELECT sell_median\n  FROM price_snapshots\n  WHERE item_slug = i.slug\n    AND collected_at <= NOW() - INTERVAL '24 hours'\n  ORDER BY collected_at DESC\n  LIMIT 1\n) prev24h ON true\nLEFT JOIN LATERAL (\n  SELECT sell_median\n  FROM price_snapshots\n  WHERE item_slug = i.slug\n    AND collected_at <= NOW() - INTERVAL '7 days'\n  ORDER BY collected_at DESC\n  LIMIT 1\n) prev7d ON true\nORDER BY change_24h_pct DESC NULLS LAST",
          "refId": "A"
        }
      ],
      "title": "All items — current price & variations",
      "type": "table"
    }
  ],
  "refresh": "5m",
  "schemaVersion": 39,
